              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 problem+json: correo ya registrado (US13 E2, TS07 E2)', function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().title).to.eql('Email already registered.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Reutiliza el correo creado por el registro exitoso. Ejecutar despues de ese request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ana Torres\",\n  \"email\": \"{{buyerEmail}}\",\n  \"phone\": \"987654321\",\n  \"password\": \"{{buyerPassword}}\",\n  \"acceptedTerms\": true,\n  \"acceptedDataProcessing\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
