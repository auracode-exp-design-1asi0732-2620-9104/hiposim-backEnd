        {
          "name": "Token opcional - Simulacion con sesion iniciada (200)",
          "description": "Requiere accessToken: ejecutar antes el registro o el login de la carpeta Auth. Con token valido la simulacion se asocia al Comprador.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con Authorization opcional', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyPrice\": 280000,\n  \"downPayment\": 42000,\n  \"annualEffectiveRate\": 0.085,\n  \"termInMonths\": 240\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/simulations", "host": ["{{baseUrl}}"], "path": ["api", "simulations"] }
          }
        },
