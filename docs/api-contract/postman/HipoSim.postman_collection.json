    {
      "name": "Auth",
      "description": "TS07, US13, US26. Ejecutar en orden: el primer request crea el correo y guarda el accessToken.",
      "item": [
        {
          "name": "TS07 E1 / US13 E1 - Registro exitoso (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('buyerEmail', 'buyer.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 con token JWT y usuario comprador (US13 E1, TS07 E1)', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.tokenType).to.eql('Bearer');",
                  "  pm.expect(b.expiresIn).to.be.above(0);",
                  "  pm.expect(b.accessToken.split('.').length).to.eql(3);",
                  "  pm.expect(b.user.role).to.eql('buyer');",
                  "  pm.expect(b.user.email).to.eql(pm.collectionVariables.get('buyerEmail'));",
                  "  pm.collectionVariables.set('accessToken', b.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ana Torres\",\n  \"email\": \"{{buyerEmail}}\",\n  \"phone\": \"987654321\",\n  \"password\": \"{{buyerPassword}}\",\n  \"acceptedTerms\": true,\n  \"acceptedDataProcessing\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "TS07 E2 / US13 E2 - Correo ya registrado (409)",
          "event": [
