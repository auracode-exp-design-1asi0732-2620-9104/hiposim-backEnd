{
  "info": {
    "name": "HipoSim API v0.1.0",
    "description": "Coleccion de la seccion 5.2.6 (RESTful API Documentation). Auth (TS07, US13, US26) y Simulations (TS06) estan implementados. Agencies y Leads son carpetas vacias que se llenan cuando existan los endpoints. Contrato: docs/api-contract/openapi.v0.yaml. Ejecutar la carpeta Auth en orden: el registro crea el correo y el token que usan los demas requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
