    {
      "name": "Simulations",
      "description": "TS06, US01, US02, US04, US05. El simulador es publico: el token del Comprador es opcional.",
      "item": [
        {
          "name": "TS06 E1 / US01 E1 / US05 E1 - Simulacion calculada con bono (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y application/json', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const b = pm.response.json();",
                  "pm.test('cuota, TCEA, VAN, TIR y cronograma (TS06 E1)', function () {",
                  "  pm.expect(b.financedAmount).to.eql(219800);",
                  "  pm.expect(b.monthlyInstallment).to.eql(1863.99);",
                  "  pm.expect(b.tcea).to.be.closeTo(0.085, 0.000001);",
                  "  pm.expect(b).to.have.property('npv');",
                  "  pm.expect(b).to.have.property('irr');",
                  "});",
                  "pm.test('bono descontado del monto a financiar (US05 E1)', function () {",
                  "  pm.expect(b.benefit.eligible).to.eql(true);",
                  "  pm.expect(b.benefit.appliedAmount).to.eql(18200);",
                  "});",
                  "pm.test('cronograma con saldo inicial, amortizacion, interes y saldo final (US02 E1)', function () {",
                  "  pm.expect(b.amortizationSchedule.length).to.eql(240);",
                  "  pm.expect(b.amortizationSchedule[0].openingBalance).to.eql(219800);",
                  "  pm.expect(b.amortizationSchedule[239].remainingBalance).to.eql(0);",
                  "});",
                  "pm.collectionVariables.set('simulationId', b.simulationId);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyPrice\": 280000,\n  \"downPayment\": 42000,\n  \"annualEffectiveRate\": 0.085,\n  \"termInMonths\": 240,\n  \"gracePeriodMonths\": 0,\n  \"graceType\": \"none\",\n  \"applyGoodPayerBonus\": true,\n  \"startDate\": \"2026-10-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/simulations", "host": ["{{baseUrl}}"], "path": ["api", "simulations"] }
          }
        },
        {
          "name": "US05 E2 - Vivienda fuera de rango (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('la vivienda no califica y el monto no cambia (US05 E2)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.benefit.eligible).to.eql(false);",
                  "  pm.expect(b.benefit.appliedAmount).to.eql(0);",
                  "  pm.expect(b.financedAmount).to.eql(360000);",
                  "  pm.expect(b.monthlyInstallment).to.eql(3052.94);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
